# Listen locally by default. Do not expose this service to the public internet.
MINISFTP_HOST=127.0.0.1
MINISFTP_PORT=8000
# Optional absolute boundary for local browsing and transfers.
# Empty starts at user home and allows browsing the local filesystem.
MINISFTP_LOCAL_ROOT=
# Number of simultaneous transfers (1-4)
MINISFTP_TRANSFER_CONCURRENCY=2
# Chunk size in bytes (256 KiB default)
MINISFTP_CHUNK_SIZE=262144
# Optional: override OpenSSH config or use an isolated app data directory.
# MINISFTP_SSH_CONFIG_PATH=C:/Users/your-user/.ssh/config
# MINISFTP_DATA_PATH=D:/MiniSFTPData
