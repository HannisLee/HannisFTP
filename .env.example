# Listen locally by default. Do not expose this service to the public internet.
MINISFTP_HOST=127.0.0.1
MINISFTP_PORT=8000
# Optional absolute local directory that the local pane may browse and modify.
# Empty means the current user's home directory.
MINISFTP_LOCAL_ROOT=
# Number of simultaneous transfers (1-4)
MINISFTP_TRANSFER_CONCURRENCY=2
# Chunk size in bytes (256 KiB default)
MINISFTP_CHUNK_SIZE=262144
